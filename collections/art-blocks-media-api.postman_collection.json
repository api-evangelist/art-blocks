          "name": "Get static PNG render of token artwork",
          "request": {
            "name": "Get static PNG render of token artwork",
            "description": {
              "content": "Returns a static PNG image of the Art Blocks token artwork, captured by a headless browser executing the generative script. This is the canonical static image used on artblocks.io and by NFT marketplaces for thumbnail display.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":chainId",
                ":contractAddress",
                "{{tokenId}}.png"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "chainId",
                  "description": "(Required) Chain ID of the network. Use 1 for Ethereum, 42161 for Arbitrum One, 8453 for Base."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "contractAddress",
                  "description": "(Required) Ethereum address of the Art Blocks core contract."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "image/png"
              }
            ],
            "method": "GET",
