          "name": "Get live generative artwork view",
          "request": {
            "name": "Get live generative artwork view",
            "description": {
              "content": "Returns an HTML page containing the live generative artwork for a given token, suitable for embedding in an iframe. The page executes the artist's on-chain script in the browser using the token's deterministic hash as the PRNG seed. This is the canonical live view of the artwork as defined by the on-chain contract.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":chainId",
                ":contractAddress",
                ":tokenId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "chainId",
                  "description": "(Required) Chain ID of the network. Use 1 for Ethereum, 42161 for Arbitrum One, 8453 for Base."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "contractAddress",
                  "description": "(Required) Ethereum address of the Art Blocks core contract."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "tokenId",
                  "description": "(Required) The ERC-721 token ID."
                }
              ]
