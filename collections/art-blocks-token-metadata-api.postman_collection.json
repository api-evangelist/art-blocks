      "item": [
        {
          "id": "521a44d2-5d06-4443-8585-016cbdd2b25b",
          "name": "Get token metadata",
          "request": {
            "name": "Get token metadata",
            "description": {
              "content": "Returns ERC-721 token metadata for a given Art Blocks token, conforming to the OpenSea metadata standard. The response includes the live view URL (generator) and media proxy URL (static PNG) so integrators can obtain all asset links from a single call.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":chainId",
                ":contractAddress",
                ":tokenId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "chainId",
                  "description": "(Required) Chain ID of the network. Use 1 for Ethereum, 42161 for Arbitrum One, 8453 for Base."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "contractAddress",
                  "description": "(Required) Ethereum address of the Art Blocks core contract."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "tokenId",
                  "description": "(Required) The ERC-721 token ID. For Art Blocks flagship contracts the token ID encodes the project ID (token_id = project_id * 1,000,000 + invocation)."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
